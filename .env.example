# --- Agent-Chat · configuracion (copiar a .env y rellenar) ---

# Donde vive el proceso y donde guarda datos/estaticos
CHAT_PORT=8792
CHAT_DATA=/home/USER/agent-chat/data
CHAT_STATIC=/home/USER/agent-chat/static

# OpenMausBot local (el agente corre en el mismo host)
OMB_URL=http://127.0.0.1:8799
OMB_BOT_ID=00000000-0000-0000-0000-000000000000
OMB_THREAD_ID=00000000-0000-0000-0000-000000000000

# Unico email autorizado a entrar (en minusculas)
CHAT_OWNER=tu@ejemplo.com

# Marca que se muestra en la cabecera y en los textos
CHAT_BRAND=Agent Chat
# Nombre de la PWA instalada (opcional; por defecto el del manifiesto)
CHAT_PWA_NAME=Agent Chat

# Remitente del codigo de acceso (SMTP directo al MX del dominio emisor)
CHAT_MAIL_NAME=Agent Chat
CHAT_MAIL_FROM=no-reply@ejemplo.com
CHAT_MAIL_DOMAIN=ejemplo.com
SMTP_HOST=127.0.0.1
SMTP_PORT=25

# Contacto VAPID para las notificaciones push
VAPID_SUB=mailto:tu@ejemplo.com

# --- Funciones de esta variante (B) ---
# Una sola burbuja por turno del agente, actualizada en vivo; push al nacer y al cerrar.
CHAT_OPTION_B=1
# Texto del push de inicio de turno.
CHAT_B_START_PUSH=El agente esta trabajando...
# Control de turno: enviar mientras trabaja (steer) y boton Detener (interrupt).
CHAT_TURN_CONTROL=1
# Boton "Depurar": porcentaje de LINEAS de historial que se poda (frontera de turno).
CHAT_PURGE_PCT=66
# Legado: numero de mensajes que conservaba la version antigua de "Depurar".
CHAT_DEBUG_KEEP=40
